# These are injected automatically when the project is provisioned by Tawjeeh
# Studio. They are listed here only for reference — you do not set them by hand.

# The Masar dashboard that hosts the widget and receives feedback.
MASAR_DASHBOARD_URL=https://app.tawjeehai.cloud
# Server-to-server secret used to mint widget tokens (never exposed to the browser).
MASAR_ISSUER_SECRET=
# The organization domain this app's feedback is attributed to (organizations.domain).
MASAR_ORG_DOMAIN=
# The Space (project) id feedback is filed under.
MASAR_SPACE_ID=
# Human-readable Space name, shown in the widget.
MASAR_SPACE_NAME=

# This project's own Supabase (for the app's data + employee auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
